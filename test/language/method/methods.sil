var Counter = {
    .__init = (this, count) => this.c = count,
    .__add  = (this, other) => this.c += other,
    .__sub  = (this, other) => this.c -= other,
    .__mul  = (this, other) => this.c *= other,
    .__fdiv = (this, other) => this.c /= other,
    .__pow  = (this, other) => this.c **= other,
    .__idiv = (this, other) => this.c //= other,
    .__mod  = (this, other) => this.c %= other,
    .__and  = (this, other) => this.c &= other,
    .__xor  = (this, other) => this.c ^= other,
    .__or   = (this, other) => this.c |= other,
    .__lsh  = (this, other) => this.c <<= other,
    .__rsh  = (this, other) => this.c >>= other,
    .__lt   = (this, other) => this.c < other,
    .__le   = (this, other) => this.c <= other,
    .__rev  =          this => this.c = ~this.c,
    .__neg  =          this => this.c = -this.c,
    .__pos  =          this => this.c = +this.c,
};

var c = new Counter(10);

print(c + 5, c.c); # out: 15 15
print(c - 5, c.c); # out: 10 10
print(c * 5, c.c); # out: 50 50
print(c / 5, c.c); # out: 10 10
print(c ** 2, c.c); # out: 100 100
print(c // 6, c.c); # out: 16 16
print(c % 14, c.c); # out: 2 2
print(c & 3, c.c); # out: 2 2
print(c ^ 2, c.c); # out: 0 0
print(c | 5, c.c); # out: 5 5
print(c << 5, c.c); # out: 160 160
print(c >> 5, c.c); # out: 5 5
print(c < 5, c.c); # out: false 5
print(c <= 5, c.c); # out: true 5
print(c > 5, c.c); # out: false 5
print(c >= 5, c.c); # out: true 5
print(~c, c.c); # out: -6 -6 
print(-c, c.c); # out: 6 6
print(+c, c.c); # out: 6 6
