print("PI = %(3 + 0.14), E = %(1.6 * 10 ** -19), K = %(9 * 10 ** 9)");
# out: PI = 3.14, E = 1.6e-19, K = 9000000000

print("PI = %(
        3 +
        0.14
    ), E = %(
        1.6 *
        10
        ** -19
    ), K = %(
        9 *
        10 **
        9
    )"
);
# out: PI = 3.14, E = 1.6e-19, K = 9000000000
