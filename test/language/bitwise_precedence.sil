print(2 | 1 << 1); # out: 2
print(1 << 1 | 2); # out: 2

print(2 & 1 << 1); # out: 2
print(1 << 1 & 2); # out: 2

print(2 ^ 1 << 1); # out: 0
print(1 << 1 ^ 2); # out: 0

print(1 & 1 | 2); # out: 3
print(2 | 1 & 1); # out: 3

print(1 & 1 ^ 2); # out: 3
print(2 ^ 1 & 1); # out: 3

print(1 ^ 1 | 1); # out: 1
print(1 | 1 ^ 1); # out: 1
